{
  "name": "moviedb",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=26.10.0"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:db": "dotenv -e .env.test -- prisma migrate deploy && jest",
    "postinstall": "prisma generate",
    "db:generate:migration": "prisma migrate dev --create-only",
    "db:migrate:dev": "prisma migrate dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "npm run db:generate-client && npm run lint && npm run test && npm run typecheck && NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production npm run build",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:generate-client": "prisma generate",
    "daily-summary": "tsx scripts/daily-summary.ts",
    "db:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevbob1/moviedb.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "homepage": "https://github.com/kevbob1/moviedb#readme",
  "type": "module",
